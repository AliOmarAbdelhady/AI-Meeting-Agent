# =============================================================================
# AI Meeting Agent - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AI Meeting Agent
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite for development, PostgreSQL for production
DATABASE_URL=sqlite+aiosqlite:///./data/meeting_agent.db
DATABASE_URL_SYNC=sqlite:///./data/meeting_agent.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://meeting_agent:changeme@localhost:5432/meeting_agent
# DATABASE_URL_SYNC=postgresql://meeting_agent:changeme@localhost:5432/meeting_agent

# ── OpenAI / LLM ────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.3

# ── Whisper (Speech-to-Text) ────────────────────────────────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# WHISPER_LANGUAGE=en  # Leave empty for auto-detect

# ── Email (SendGrid) ────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
EMAIL_FROM_ADDRESS=meeting-agent@example.com
EMAIL_FROM_NAME=AI Meeting Agent
EMAIL_PROVIDER=sendgrid  # Options: sendgrid, smtp

# ── Email (SMTP fallback) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ── Meeting Bot ─────────────────────────────────────────────────────────────
BOT_HEADLESS=true
BOT_BROWSER_TIMEOUT=30
BOT_AUDIO_SAMPLE_RATE=16000
BOT_AUDIO_CHANNELS=1
# Google account for bot to join meetings
BOT_GOOGLE_EMAIL=
BOT_GOOGLE_PASSWORD=

# ── Google Calendar ─────────────────────────────────────────────────────────
GOOGLE_CALENDAR_CREDENTIALS_PATH=./credentials/google-credentials.json
GOOGLE_CALENDAR_TOKEN_PATH=./credentials/google-token.json

# ── Audio Recording ─────────────────────────────────────────────────────────
AUDIO_OUTPUT_DIR=./data/audio
AUDIO_FORMAT=wav
AUDIO_MAX_DURATION_SECONDS=14400

# ── Scheduler ───────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
SCHEDULER_CHECK_INTERVAL_SECONDS=60
